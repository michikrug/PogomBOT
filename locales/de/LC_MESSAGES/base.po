#: pogobot.py:188
msgid "*The PoGo Chemnitz Bot knows the following commands:*"
msgstr "*Der PoGo Chemnitz Bot beherrscht die folgenden Befehle:*"

#: pogobot.py:189
msgid "*General*"
msgstr "*Allgemein*"

#: pogobot.py:190
msgid "/start"
msgstr ""

#: pogobot.py:190
msgid "Starts the bot (e.g. after pausing)"
msgstr "Startet den Bot (z.B. nach dem Pausieren)"

#: pogobot.py:191
msgid "/stop"
msgstr ""

#: pogobot.py:191
msgid "Pauses the bot (use /start to resume)"
msgstr "Pausiert den Bot (nutze /start zum Fortsetzen)"

#: pogobot.py:192
msgid "/list"
msgstr ""

#: pogobot.py:192
msgid "Lists the watched Pokémon and Raid Pokémon"
msgstr "Zeigt eine Liste mit den überwachten Pokémon und Raid-Pokémon"

#: pogobot.py:193
msgid "/language"
msgstr "/language en/de"

#: pogobot.py:193
msgid "Sets the language of the bot"
msgstr "Setzt die Sprache des Bots"

#: pogobot.py:194
msgid "/clear"
msgstr ""

#: pogobot.py:194
msgid "Resets all your settings"
msgstr "Setzt alle deine Einstellungen zurück"

#: pogobot.py:195
msgid "/help"
msgstr ""

#: pogobot.py:195
msgid "Shows a list of available commands"
msgstr "Zeigt eine Liste mit verfügbaren Befehlen"

#: pogobot.py:196 pogobot.py:582
msgid "/where"
msgstr "/wo Arena-Name"

#: pogobot.py:196
msgid "Searches for a gym by name and outputs its location"
msgstr "Sucht nach einer Arena mit dem Name und gibt deren Standort zurück"

#: pogobot.py:197
msgid "*Pokémon filter*"
msgstr "*Pokémon-Filter*"

#: pogobot.py:198 pogobot.py:595
msgid "/add pokedexID"
msgstr ""

#: pogobot.py:198
msgid "Adds Pokémon with the given ID to the scanner"
msgstr "Fügt Pokémon mit der gegebenen ID zum Scanner hinzu"

#: pogobot.py:199 pogobot.py:595
msgid "/add pokedexID1 pokedexID2 ..."
msgstr ""

#: pogobot.py:200 pogobot.py:629
msgid "/addbyrarity 1-5"
msgstr ""

#: pogobot.py:200
msgid "Adds Pokémon with the given rarity to scanner (1 very common - 5 ultrarare)"
msgstr "Fügt Pokémon it der gegebenen Seltenheit zum Scanner hinzu (1 sehr häufig - 5 ultra selten)"

#: pogobot.py:201 pogobot.py:682
msgid "/remove pokedexID"
msgstr ""

#: pogobot.py:201
msgid "Removes Pokémon with the given ID from the scanner"
msgstr "Entfernt Pokémon mit der gegebenen ID vom Scanner"

#: pogobot.py:202
msgid "/remove pokedexID1 pokedexID2 ..."
msgstr ""

#: pogobot.py:203
msgid "/iv"
msgstr "/iv 0-100"

#: pogobot.py:203
msgid "Sets the minimum IVs given as percent"
msgstr "Setzt den Minimal-IV-Wert in Prozent"

#: pogobot.py:204
msgid "/cp"
msgstr "/wp 0-4548"

#: pogobot.py:204
msgid "Sets the minimum CP"
msgstr "Setzt den Minimal-WP-Wert"

#: pogobot.py:205
msgid "/level"
msgstr "/level 0-30"

#: pogobot.py:205
msgid "Sets the minimum level"
msgstr "Setzt das Minimal-Level"

#: pogobot.py:206
msgid "/pkmiv"
msgstr "/pkmiv pokedexID 0-100"

#: pogobot.py:206
msgid "Sets the minimum IVs for a specific Pokémon given as percent"
msgstr "Setzt den Minimal-IV-Wert für ein bestimmtes Pokémon in Prozent"

#: pogobot.py:207
msgid "/resetpkmiv"
msgstr "/resetpkmiv pokedexID"

#: pogobot.py:207
msgid "Resets the minimum IVs for a specific Pokémon"
msgstr "Setzt den Minimal-IV-Wert für ein bestimmtes Pokémon zurück"

#: pogobot.py:208
msgid "/pkmcp"
msgstr "/pkmwp pokedexID 0-4548"

#: pogobot.py:208
msgid "Sets the minimum CP for a specific Pokémon"
msgstr "Setzt den Minimal-WP-Wert für ein bestimmtes Pokémon"

#: pogobot.py:209
msgid "/resetpkmcp"
msgstr "/resetpkmwp pokedexID"

#: pogobot.py:209
msgid "Resets the minimum CP for a specific Pokémon"
msgstr "Setzt den Minimal-WP-Wert für ein bestimmtes Pokémon zurück"

#: pogobot.py:210
msgid "/pkmlevel"
msgstr "/pkmlevel pokedexID 0-30"

#: pogobot.py:210
msgid "Sets the minimum level for a specific Pokémon"
msgstr "Setzt das Minimal-Level für ein bestimmtes Pokémon"

#: pogobot.py:211
msgid "/resetpkmlevel"
msgstr "/resetpkmlevel pokedexID"

#: pogobot.py:211
msgid "Resets the minimum level for a specific Pokémon"
msgstr "Setzt das Minimal-Level für ein bestimmtes Pokémon zurück"

#: pogobot.py:212
msgid "/matchmode"
msgstr "/matchmode 0/1/2"

#: pogobot.py:212
msgid ""
"Sets the match mode (0) Distance AND IVs AND CP AND level / (1) Distance AND "
"IVs OR CP OR level has to match / (2) Distance OR IVs OR CP OR level has to "
"match"
msgstr ""
"Legt den Übereinstimmungs-Modus fest (0) Entfernung UND IV- UND WP-Wert UND "
"Level / (1) Entfernung UND IV- ODER WP-Wert ODER Level muss übereinstimmen / "
"(2) Entfernung ODER IV- ODER WP-Wert ODER Level muss übereinstimmen"

#: pogobot.py:213
msgid "/pkmmatchmode"
msgstr "/pkmmatchmode pokedexID 0/1/2"

#: pogobot.py:213
msgid "Set the match mode for a specific Pokémon"
msgstr "Legt den Übereinstimmungs-Modus für ein bestimmtes Pokémon fest"

#: pogobot.py:214
msgid "/resetpkmmatchmode"
msgstr "/resetpkmmatchmode pokedexID"

#: pogobot.py:214
msgid "Reset the match mode for a specific Pokémon"
msgstr "Setzt den Übereinstimmungs-Modus für ein bestimmtes Pokémon zurück"

#: pogobot.py:215
msgid "/pkmradius"
msgstr "/pkmradius pokedexID km"

#: pogobot.py:215
msgid "Sets the search radius for a specific Pokémon in km"
msgstr "Setzt den Suchradius für ein bestimmtes Pokémon in km"

#: pogobot.py:216
msgid "/resetpkmradius"
msgstr "/resetpkmradius pokedexID"

#: pogobot.py:216
msgid "Resets the search radius for a specific Pokémon"
msgstr "Setzt den Suchradius für ein bestimmtes Pokémon zurück"

#: pogobot.py:217
msgid "/sendwithout"
msgstr "/sendwithout true/false"

#: pogobot.py:217
msgid "Defines if Pokémon without IV/CP should be sent"
msgstr "Legt fest, ob Pokémon ohne IV/WP-Werte gesendet werden sollen"

#: pogobot.py:218
msgid "/showivs"
msgstr ""

#: pogobot.py:218
msgid "Defines if Individual Values should be displayed"
msgstr "Legt fest, ob einzelne IV-Werte dargestellt werden sollen"

#: pogobot.py:219
msgid "*Raid filter*"
msgstr "*Raid-Filter*"

#: pogobot.py:220
msgid "/newraid"
msgstr ""

#: pogobot.py:220
msgid "Adds a new Raid entry to the database"
msgstr "Fügt einen neuen Raid zur Datenbank hinzu"

#: pogobot.py:221 pogobot.py:735
msgid "/addraid pokedexID"
msgstr ""

#: pogobot.py:221
msgid "Adds Raid Pokémon with the given ID to the scanner"
msgstr "Fügt Raid-Pokémon mit der gegebenen ID zum Scanner hinzu"

#: pogobot.py:222 pogobot.py:735
msgid "/addraid pokedexID1 pokedexID2 ..."
msgstr ""

#: pogobot.py:223 pogobot.py:695
msgid "/addraidbylevel 1-5"
msgstr ""

#: pogobot.py:223
msgid "Adds Raid Pokémon with the given level to scanner (1-5)"
msgstr "Fügt Raid-Pokémon it dem gegebenen Level zum Scanner hinzu (1-5)"

#: pogobot.py:224 pogobot.py:782
msgid "/removeraid pokedexID"
msgstr ""

#: pogobot.py:224
msgid "Removes Raid Pokémon with the given ID from the scanner"
msgstr "Entfernt Raid-Pokémon mit der gegebenen ID vom Scanner"

#: pogobot.py:225
msgid "/removeraid pokedexID1 pokedexID2 ..."
msgstr ""

#: pogobot.py:226
msgid "*Distance filter*"
msgstr "*Entfernungs-Filter*"

#: pogobot.py:227
msgid "/location address"
msgstr "/location Adresse"

#: pogobot.py:227
msgid "Sets the desired search location given as text"
msgstr "Setzt die Suchposition gegeben als Text"

#: pogobot.py:228
msgid "/radius km"
msgstr ""

#: pogobot.py:228
msgid "Sets the search radius in km"
msgstr "Setzt den Suchradius in km"

#: pogobot.py:229
msgid "/removelocation"
msgstr ""

#: pogobot.py:229
msgid "Clears the search location and radius"
msgstr "Setzt die Suchposition und den Radius zurück"

#: pogobot.py:230
msgid "/raidradius"
msgstr "/raidradius pokedexID km"

#: pogobot.py:230
msgid "Sets the search radius for a specific Raid Pokémon in km"
msgstr "Setzt den Suchradius für ein bestimmtes Raid-Pokémon in km"

#: pogobot.py:231
msgid "/resetraidradius"
msgstr "/resetraidradius pokedexID"

#: pogobot.py:231
msgid "Resets the search radius for a specific Raid Pokémon"
msgstr "Setzt den Suchradius für ein bestimmtes Raid-Pokémon zurück"

#: pogobot.py:232
msgid "*Notification settings*"
msgstr "*Benachrichtigungs-Einstellungen*"

#: pogobot.py:233
msgid "/cleanup"
msgstr ""

#: pogobot.py:233
msgid "Defines if messages of disappeared Pokémon should be deleted"
msgstr "Legt fest, ob Benachrichtigungen zu verschwundenen Pokémons gelöscht werden sollen"

#: pogobot.py:234
msgid "/stickers"
msgstr "/stickers true/false"

#: pogobot.py:234
msgid "Defines if stickers should be sent"
msgstr "Legt fest, ob Sticker gesendet werden sollen"

#: pogobot.py:235
msgid "/maponly"
msgstr "/maponly true/false"

#: pogobot.py:235
msgid "Defines if only a map should be sent (without an additional message/sticker)"
msgstr "Legt fest, ob nur eine Karte gesendet werden soll (ohne zusätzliche Nachricht/Sticker)"

#: pogobot.py:236
msgid "Hint: You can also set the scanning location by just sending a location marker"
msgstr "Hinweis: Du kannst ebenso die Suchposition festlegen, indem du einfach einen Positionsmarker sendest"

